<?xml version="1.0" encoding="utf-8" ?>
<nlog xmlns="http://www.nlog-project.org/schemas/NLog.xsd"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      autoReload="true"
      internalLogLevel="Warn"
      internalLogFile="${basedir}/logs/internal-nlog.txt">

	<extensions>
		<add assembly="NLog.Web.AspNetCore" />
	</extensions>

	<targets>
		<!-- All logs, one file per day, keeps the last 14 days -->
		<target xsi:type="File" name="allfile"
				fileName="${basedir}/logs/fundoo-${shortdate}.log"
				layout="${longdate} | ${level:uppercase=true} | ${logger} | ${message} ${exception:format=tostring}"
				maxArchiveFiles="14" />

		<!-- Errors only -->
		<target xsi:type="File" name="errorfile"
				fileName="${basedir}/logs/fundoo-errors-${shortdate}.log"
				layout="${longdate} | ${level:uppercase=true} | ${logger} | ${message} ${exception:format=tostring}"
				maxArchiveFiles="30" />

		<target xsi:type="Console" name="console"
				layout="${time} | ${level:uppercase=true} | ${logger:shortName=true} | ${message} ${exception:format=tostring}" />
	</targets>

	<rules>
		<!-- Hide noisy framework logs below Warning -->
		<logger name="Microsoft.*" maxlevel="Info" final="true" />
		<logger name="System.Net.Http.*" maxlevel="Info" final="true" />

		<logger name="*" minlevel="Info" writeTo="allfile,console" />
		<logger name="*" minlevel="Error" writeTo="errorfile" />
	</rules>
</nlog>